# Provedor de LLM usado pelo concierge: "fake" (offline, sem custo, sem chave)
# ou "openrouter" (chama a API real da OpenRouter).
LLM=fake

# Necessário apenas quando LLM=openrouter.
# Crie sua chave em https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Modelo usado na OpenRouter quando LLM=openrouter (opcional).
OPENROUTER_MODEL=openai/gpt-4o-mini

# Porta HTTP da API Fastify.
PORT=3000

# Caminho do arquivo JSON usado para persistir as reservas em disco.
DATA_FILE=./data/reservations.json
